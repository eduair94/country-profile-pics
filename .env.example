# Copy to .env (never commit it). Both the CLI and the web UI read it.

# A website key (wapi_…) or a RapidAPI key subscribed to "WP Data DB Only".
WA_API_KEY=

# auto | direct | rapidapi — auto picks from the shape of the key.
WA_TRANSPORT=auto

# Where pictures are saved (one folder per country).
OUT_DIR=./downloads

# Web UI. Keep HOST=127.0.0.1 unless you understand that anyone who can reach
# the port can spend WA_API_KEY. ALLOWED_HOSTS lists extra Host names to accept.
HOST=127.0.0.1
PORT=4747
ALLOWED_HOSTS=

# Minimum gap between API requests, in ms (the direct proxy refuses < 500).
MIN_INTERVAL_MS=550
